{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apache Ignite REST module clusterConfiguration clusterManagement API",
    "version": "3.1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "clusterManagement",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apache Ignite Initialize Cluster",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:10300/management/v1/cluster/init",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Initialize a new cluster."
        },
        {
          "info": {
            "name": "Apache Ignite Get Cluster State",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:10300/management/v1/cluster/state"
          },
          "docs": "Returns current cluster status."
        }
      ]
    }
  ],
  "bundled": true
}